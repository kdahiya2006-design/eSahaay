# eSahaay Configuration

# AI Provider: "mock" (default, deterministic rule-based demo), "gemini", or "openai"
AI_PROVIDER=mock

# AI API Key (Leave blank to use built-in deterministic demo mode without paid API)
AI_API_KEY=

# AI Model Name
# For Gemini: gemini-1.5-pro or gemini-1.5-flash
# For OpenAI: gpt-4o or gpt-4o-mini
AI_MODEL=gemini-1.5-pro

# SQLite Database Location
DATABASE_PATH=cases.db
